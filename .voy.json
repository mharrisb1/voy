{
  "debounce_ms": 150,
  "routes": [
    {
      "name": "test_pipeline",
      "watch": ["src/**/*.cpp", "include/**/*.hpp", "include/**/*.h"],
      "ignore": ["build/**"],
      "events": ["all"],
      "action": {
        "command": "echo '{\"route\": \"'$VOY_ROUTE_NAME'\", \"batch_size\": '$VOY_BATCH_SIZE', \"event_type\":\"'$VOY_EVENT_TYPE'\", \"path\": \"'$VOY_EVENT_PATH'\"}' | jq",
        "workdir": "."
      }
    }
  ]
}
