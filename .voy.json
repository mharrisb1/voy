{
  "debounce_ms": 1000,
  "routes": [
    {
      "name": "test_pipeline",
      "watch": ["src/**/*.cpp", "include/**/*.hpp", "include/**/*.h"],
      "ignore": ["build/**"],
      "events": ["all"],
      "action": {
        "command": "echo '{\"timestamp\": \"'$VOY_EVENT_TIME'\", \"route\": \"'$VOY_ROUTE_NAME'\", \"batch_size\": '$VOY_BATCH_SIZE', \"event_type\":\"'$VOY_EVENT_TYPE'\", \"path\": \"'$VOY_EVENT_PATH'\"}' | jq",
        "workdir": "."
      }
    },
    {
      "name": "banner_markings",
      "watch": ["src/**/*.cpp", "include/**/*.hpp", "include/**/*.h"],
      "ignore": ["build/**"],
      "events": ["create", "modify"],
      "action": {
        "command": "markings fix $VOY_EVENT_PATH"
      }
    }
  ]
}
